// id:          IDN-DET-001
// name:        Privileged directory role assigned outside PIM
// type:        detect
// status:      testing
// time_column: TimeGenerated
// tables:      AuditLogs
// requires:    none
// parameters:  Lookback
// severity:    High
// frequency:   1h
// tactics:     PrivilegeEscalation, Persistence
// mitre:       T1098.003
// entities:    Account=TargetName, Account=Actor, IP=ActorIP
// author:      JR
// updated:     2026-10-28
//
// Notes: A privileged Entra ID directory role was assigned directly rather than through a PIM
// activation. Attackers who take over an admin account often grant a standing role to a
// second account they control.
// Expected false positives: break-glass setup and documented admin changes. Exclude known
// automation accounts by Actor if needed.
let Lookback = 1h;
let PrivilegedRoles = dynamic([
    "Global Administrator",
    "Privileged Role Administrator",
    "Privileged Authentication Administrator",
    "Security Administrator",
    "Conditional Access Administrator",
    "Authentication Administrator",
    "User Administrator",
    "Application Administrator",
    "Cloud Application Administrator",
    "Hybrid Identity Administrator",
    "Exchange Administrator",
    "SharePoint Administrator",
    "Intune Administrator"
    ]);
AuditLogs
| where TimeGenerated > ago(Lookback)
| where OperationName == "Add member to role"
| where Result =~ "success"
| extend InitiatorApp = tostring(InitiatedBy.app.displayName)
// PIM activations are written by the MS-PIM service principal
| where InitiatorApp != "MS-PIM"
| extend
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), InitiatorApp),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| mv-expand Target = TargetResources
| mv-expand Prop = Target.modifiedProperties
| where tostring(Prop.displayName) == "Role.DisplayName"
| extend RoleName = trim(@'"', tostring(Prop.newValue))
| where RoleName in~ (PrivilegedRoles)
| project
    TimeGenerated,
    RoleName,
    TargetName = coalesce(tostring(Target.userPrincipalName), tostring(Target.displayName)),
    TargetType = tostring(Target.type),
    Actor,
    ActorIP,
    CorrelationId
