// id:          IDN-HNT-001
// name:        Password spray by source IP
// type:        hunt
// status:      testing
// time_column: TimeGenerated
// tables:      SigninLogs, AADNonInteractiveUserSignInLogs
// requires:    IdentitySignins
// parameters:  StartTime, EndTime, MinDistinctUsers
// entities:    IP, Account
// mitre:       T1110.003
// author:      JR
// updated:     2026-10-28
//
// Notes: Finds source IPs with failed passwords across many users, then shows which users had
// a correct password from the same IP. A correct password includes success, MFA required, and
// Conditional Access blocks, because all of these happen after the password is accepted.
// Rows with values in PasswordAcceptedUsers are the priority. Run IDN-INV-001 on those users.
let StartTime = ago(1d);
let EndTime = now();
let MinDistinctUsers = 10;
// 50126 invalid credentials, 50053 locked or malicious IP, 50055 expired, 50056 invalid or null, 50057 disabled
let SprayFailureCodes = dynamic(["50126", "50053", "50055", "50056", "50057"]);
// 0 success, 50074 / 50076 MFA required, 53003 blocked by Conditional Access
let PasswordAcceptedCodes = dynamic(["0", "50074", "50076", "53003"]);
// BEGIN IdentitySignins
let IdentitySignins = (Start:datetime, End:datetime) {
    union isfuzzy=true
        (SigninLogs
        | where TimeGenerated between (Start .. End)
        | extend
            SigninType = "Interactive",
            Loc = todynamic(LocationDetails),
            Dev = todynamic(DeviceDetail),
            Stat = todynamic(Status),
            ASN = tostring(AutonomousSystemNumber)),
        (AADNonInteractiveUserSignInLogs
        | where TimeGenerated between (Start .. End)
        | extend
            SigninType = "NonInteractive",
            Loc = todynamic(LocationDetails),
            Dev = todynamic(DeviceDetail),
            Stat = todynamic(Status),
            ASN = tostring(AutonomousSystemNumber))
    | project
        TimeGenerated,
        SigninType,
        UserPrincipalName,
        UserId,
        IPAddress,
        ASN,
        Country = tostring(Loc.countryOrRegion),
        City = tostring(Loc.city),
        AppDisplayName,
        AppId,
        ResourceDisplayName,
        ClientAppUsed,
        UserAgent,
        ResultType = tostring(ResultType),
        FailureReason = tostring(Stat.failureReason),
        AuthenticationRequirement,
        ConditionalAccessStatus,
        RiskLevelDuringSignIn,
        RiskState,
        DeviceId = tostring(Dev.deviceId),
        DeviceName = tostring(Dev.displayName),
        DeviceOS = tostring(Dev.operatingSystem),
        DeviceTrustType = tostring(Dev.trustType),
        DeviceIsCompliant = tostring(Dev.isCompliant),
        SessionId = column_ifexists("SessionId", ""),
        CorrelationId,
        Id
};
// END IdentitySignins
let Signins = IdentitySignins(StartTime, EndTime)
    | where ResultType in (SprayFailureCodes) or ResultType in (PasswordAcceptedCodes)
    | extend UserPrincipalName = tolower(UserPrincipalName);
Signins
| where ResultType in (SprayFailureCodes)
| summarize
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    FailedAttempts = count(),
    FailedUsers = dcount(UserPrincipalName),
    SampleFailedUsers = make_set(UserPrincipalName, 25),
    Apps = make_set(AppDisplayName, 10),
    UserAgents = make_set(UserAgent, 10)
    by IPAddress, ASN, Country
| where FailedUsers >= MinDistinctUsers
| join kind=leftouter (
    Signins
    | where ResultType in (PasswordAcceptedCodes)
    | summarize
        PasswordAcceptedUsers = make_set(UserPrincipalName, 50),
        PasswordAcceptedCodesSeen = make_set(ResultType)
        by IPAddress
    ) on IPAddress
| project-away IPAddress1
| extend PasswordAcceptedCount = coalesce(array_length(PasswordAcceptedUsers), 0)
| order by PasswordAcceptedCount desc, FailedUsers desc
