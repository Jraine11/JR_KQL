// id:          IDN-INV-004
// name:        Session reuse across networks for a user
// type:        investigate
// status:      testing
// time_column: TimeGenerated
// tables:      SigninLogs, AADNonInteractiveUserSignInLogs
// requires:    IdentitySignins
// parameters:  TargetUPN, StartTime, EndTime, MinDistinctASNs
// entities:    Account, IP
// mitre:       T1539, T1550.004
// author:      JR
// updated:     2026-10-29
//
// Notes: One row per sign-in session that was used successfully from more than one network.
// A session stolen in an adversary-in-the-middle (AiTM) attack keeps its SessionId when the
// attacker replays the token, so the same session shows up from the attacker's ASN or country.
// Changing IPs within one ASN is normal (mobile, IPv4/IPv6). A second country, or a hosting or
// VPN ASN appearing mid-session, is the signal. Compare the IPs with IDN-INV-001.
let TargetUPN = "user@contoso.com";
let StartTime = ago(7d);
let EndTime = now();
let MinDistinctASNs = 2;
// BEGIN IdentitySignins
let IdentitySignins = (Start:datetime, End:datetime) {
    union isfuzzy=true
        (SigninLogs
        | where TimeGenerated between (Start .. End)
        | extend
            SigninType = "Interactive",
            Loc = todynamic(LocationDetails),
            Dev = todynamic(DeviceDetail),
            Stat = todynamic(Status),
            ASN = tostring(AutonomousSystemNumber)),
        (AADNonInteractiveUserSignInLogs
        | where TimeGenerated between (Start .. End)
        | extend
            SigninType = "NonInteractive",
            Loc = todynamic(LocationDetails),
            Dev = todynamic(DeviceDetail),
            Stat = todynamic(Status),
            ASN = tostring(AutonomousSystemNumber))
    | project
        TimeGenerated,
        SigninType,
        UserPrincipalName,
        UserId,
        IPAddress,
        ASN,
        Country = tostring(Loc.countryOrRegion),
        City = tostring(Loc.city),
        AppDisplayName,
        AppId,
        ResourceDisplayName,
        ClientAppUsed,
        UserAgent,
        ResultType = tostring(ResultType),
        FailureReason = tostring(Stat.failureReason),
        AuthenticationRequirement,
        ConditionalAccessStatus,
        RiskLevelDuringSignIn,
        RiskState,
        DeviceId = tostring(Dev.deviceId),
        DeviceName = tostring(Dev.displayName),
        DeviceOS = tostring(Dev.operatingSystem),
        DeviceTrustType = tostring(Dev.trustType),
        DeviceIsCompliant = tostring(Dev.isCompliant),
        SessionId = column_ifexists("SessionId", ""),
        CorrelationId,
        Id
};
// END IdentitySignins
IdentitySignins(StartTime, EndTime)
| where UserPrincipalName =~ TargetUPN
| where ResultType == "0"
| where isnotempty(SessionId)
| summarize
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    SignIns = count(),
    DistinctASNs = dcount(ASN),
    DistinctCountries = dcount(Country),
    DistinctIPs = dcount(IPAddress),
    ASNs = make_set(ASN, 10),
    Countries = make_set(Country, 10),
    IPs = make_set(IPAddress, 20),
    Apps = make_set(AppDisplayName, 20),
    UserAgents = make_set(UserAgent, 10),
    DeviceIds = make_set(DeviceId, 5),
    SigninTypes = make_set(SigninType)
    by SessionId
| where DistinctASNs >= MinDistinctASNs
| order by DistinctCountries desc, DistinctASNs desc, FirstSeen asc
